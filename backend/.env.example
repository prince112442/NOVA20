# Copy this file to .env and fill in your real values. Never commit .env itself.

PORT=8080

# Option A: one connection string (what Render/Railway/Supabase/Neon give you)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B: separate fields (handy for local Postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=lms_db

# Set to "false" only for local Postgres without SSL. Hosted providers need SSL (default).
DB_SSL=true

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500
